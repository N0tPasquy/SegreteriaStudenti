<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="250.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.CreaAppelloController">
   <children>
      <TextField fx:id="NomeCorso" layoutX="71.0" layoutY="14.0" promptText="Nome Corso" />
      <DatePicker fx:id="DataAppello" layoutX="58.0" layoutY="68.0" promptText="Data Appello" />
      <Button fx:id="CreaAppello" layoutX="104.0" layoutY="112.0" mnemonicParsing="false" onAction="#creaAppello" text="Crea Appello" />
      <Label fx:id="ErrorCode" alignment="TOP_LEFT" layoutX="23.0" layoutY="155.0" prefHeight="81.0" prefWidth="258.0" textAlignment="CENTER" />
   </children>
</AnchorPane>
