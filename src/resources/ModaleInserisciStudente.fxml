      <TextField fx:id="NewCognome" layoutX="69.0" layoutY="99.0" promptText="Cognome" />
      <TextField fx:id="NewResidenza" layoutX="69.0" layoutY="133.0" promptText="Residenza" />
      <DatePicker fx:id="NewDataNascita" layoutX="57.0" layoutY="177.0" />
      <Button fx:id="iscriviStudente" layoutX="88.0" layoutY="210.0" mnemonicParsing="false" onAction="#iscriviStudente" text="Inserisci studente" />
      <Label layoutX="105.0" layoutY="159.0" text="Data Di Nascita" />
      <Label layoutX="75.0" layoutY="5.0" text="Inserisci nuovo studente" />
