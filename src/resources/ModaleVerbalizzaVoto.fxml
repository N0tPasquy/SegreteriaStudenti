      <Button fx:id="CercaVotiMatricola" layoutX="197.0" layoutY="39.0" mnemonicParsing="false" onAction="#cercaVotiMatricola" text="Cerca Voti" />
      <Button fx:id="VerbalizzaVoti" layoutX="94.0" layoutY="210.0" mnemonicParsing="false" onAction="#VerbalizzaVoti" text="Verbalizza Tutti" />
      <TextArea fx:id="AreaVoti" editable="false" layoutX="31.0" layoutY="75.0" prefHeight="122.0" prefWidth="245.0" />
